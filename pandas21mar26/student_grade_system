import pandas as pd

# Dataset
marks = [95, 82, 67, 58, 73, 49, 88]
students = ['S1','S2','S3','S4','S5','S6','S7']

s = pd.Series(marks, index=students)

# Function to assign grades
def grade(m):
    if m >= 90:
        return 'A'
    elif m >= 75:
        return 'B'
    elif m >= 60:
        return 'C'
    else:
        return 'D'

# Apply grading
grades = s.apply(grade)

# Count students in each grade
grade_count = grades.value_counts()

# Output
print("Marks:")
print(s)

print("\nGrades:")
print(grades)

print("\nNumber of students in each grade:")
print(grade_count)
